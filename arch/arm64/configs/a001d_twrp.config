# Recovery has no module loading: everything it needs is built in.
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# SoC
CONFIG_PINCTRL_MSM8953=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_MSM_GCC_8953=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_MAILBOX=y
CONFIG_QCOM_APCS_IPC=y
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_QCOM_RPMPD=y
CONFIG_QCOM_CLK_SMD_RPM=y
CONFIG_INTERCONNECT_QCOM_MSM8953=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_REGULATOR_QCOM_SMD_RPM=y
CONFIG_REGULATOR_QCOM_LABIBB=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_RTC_DRV_PM8XXX=y
CONFIG_POWER_RESET_MSM=y
CONFIG_POWER_RESET_QCOM_PON=y

# Storage
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_F2FS_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NTFS3_FS=y
CONFIG_FUSE_FS=y
CONFIG_BLK_DEV_LOOP=y

# USB gadget for adb and MTP
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y

# Display and touch
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_MDP5=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_14NM_PHY=y
CONFIG_DRM_PANEL_TCL_FT8719=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_QCOM_WLED=y
CONFIG_I2C_QUP=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_EDT_FT5X06=y
CONFIG_KEYBOARD_GPIO=y

# Charger and fuel gauge
CONFIG_POWER_SUPPLY=y
CONFIG_CHARGER_QCOM_SMBCHG=y
CONFIG_BATTERY_PMI8994_FG=y
CONFIG_EXTCON=y

# Battery ADC and thermal alarm
CONFIG_QCOM_SPMI_VADC=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y

# Android userspace
CONFIG_IPV6=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_SECURITY=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_AUDIT=y
CONFIG_PSI=y

# DRM_MSM=y cannot depend on these modules, and msm8953 has neither block
CONFIG_QCOM_LLCC=n
CONFIG_QCOM_OCMEM=n

# SELinux needs the network LSM hooks
CONFIG_SECURITY_NETWORK=y
CONFIG_LSM="selinux"

# Slim image: the stock LK places kernel, DTB and ramdisk close together
CONFIG_ARCH_ACTIONS=n
CONFIG_ARCH_AIROHA=n
CONFIG_ARCH_SUNXI=n
CONFIG_ARCH_ALPINE=n
CONFIG_ARCH_APPLE=n
CONFIG_ARCH_ARTPEC=n
CONFIG_ARCH_AXIADO=n
CONFIG_ARCH_BCM2835=n
CONFIG_ARCH_BCM_IPROC=n
CONFIG_ARCH_BCMBCA=n
CONFIG_ARCH_BRCMSTB=n
CONFIG_ARCH_BERLIN=n
CONFIG_ARCH_BITMAIN=n
CONFIG_ARCH_BLAIZE=n
CONFIG_ARCH_BST=n
CONFIG_ARCH_CIX=n
CONFIG_ARCH_EXYNOS=n
CONFIG_ARCH_K3=n
CONFIG_ARCH_LG1K=n
CONFIG_ARCH_HISI=n
CONFIG_ARCH_KEEMBAY=n
CONFIG_ARCH_MEDIATEK=n
CONFIG_ARCH_MESON=n
CONFIG_ARCH_MICROCHIP=n
CONFIG_ARCH_LAN969X=n
CONFIG_ARCH_SPARX5=n
CONFIG_ARCH_MMP=n
CONFIG_ARCH_MVEBU=n
CONFIG_ARCH_LAYERSCAPE=n
CONFIG_ARCH_MXC=n
CONFIG_ARCH_S32=n
CONFIG_ARCH_MA35=n
CONFIG_ARCH_NPCM=n
CONFIG_ARCH_PENSANDO=n
CONFIG_ARCH_REALTEK=n
CONFIG_ARCH_RENESAS=n
CONFIG_ARCH_ROCKCHIP=n
CONFIG_ARCH_SEATTLE=n
CONFIG_ARCH_INTEL_SOCFPGA=n
CONFIG_ARCH_SOPHGO=n
CONFIG_ARCH_STM32=n
CONFIG_ARCH_SYNQUACER=n
CONFIG_ARCH_TEGRA=n
CONFIG_ARCH_TESLA_FSD=n
CONFIG_ARCH_SPRD=n
CONFIG_ARCH_THUNDER=n
CONFIG_ARCH_THUNDER2=n
CONFIG_ARCH_UNIPHIER=n
CONFIG_ARCH_VEXPRESS=n
CONFIG_ARCH_VISCONTI=n
CONFIG_ARCH_XGENE=n
CONFIG_ARCH_ZYNQMP=n
CONFIG_ACPI=n
CONFIG_EFI=n
CONFIG_PCI=n
CONFIG_KVM=n
CONFIG_XEN=n
CONFIG_VIRTUALIZATION=n
CONFIG_WIRELESS=n
CONFIG_WLAN=n
CONFIG_BT=n
CONFIG_NFC=n
CONFIG_CAN=n
CONFIG_SOUND=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_SCSI=n
CONFIG_ATA=n
CONFIG_NETDEVICES=n
CONFIG_NETFILTER=n
CONFIG_NFS_FS=n
CONFIG_INFINIBAND=n
CONFIG_VIRTIO_MENU=n
CONFIG_FTRACE=n
CONFIG_BPF_SYSCALL=n
CONFIG_DEBUG_INFO_BTF=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_RANDOMIZE_BASE=n

# Crash log survives into the next boot; read it from the 4.9 TWRP
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
CONFIG_QCOM_CLK_APCS_MSM8953=y
CONFIG_QCOM_CPR4PD=y
CONFIG_CPU_FREQ=y
CONFIG_ARM_QCOM_CPUFREQ_NVMEM=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y

# TWRP owns the framebuffer; a kernel console would draw over it
CONFIG_FRAMEBUFFER_CONSOLE=n
CONFIG_LOGO=n
